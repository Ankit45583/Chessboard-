  <style>
  .chessboard {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(8, 1fr);
  width: 400px;  /* fixed total width */
  height: 400px; /* fixed total height */
  user-select: none; /* prevent text selection while dragging */
}

.square {
  width: 50px;   /* fixed width */
  height: 50px;  /* fixed height */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box; /* include borders/padding in size */
}

.square.light {
  background-color: #f0d9b5;
}

.square.dark {
  background-color: #b58863;
}

.piece {
  font-size: 36px;
  cursor: grab;
  width: 100%;   /* fill the square fully */
  height: 100%;  /* fill the square fully */
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;   /* prevent text selection on pieces */
}

.piece:active {
  cursor: grabbing;
}

.piece.white {
  color: white;
  filter: drop-shadow(0 0 2px black);
}

.piece.black {
  color: black;
}

.chessboard.flipped {
  transform: rotate(180deg);
}

.chessboard.flipped .piece {
  transform: rotate(180deg);
}
</style>
</head>
<body class="w-full h-screen flex items-center justify-center bg-zinc-900">
  <div id="board" class="chessboard w-96 h-96"></div>

  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" crossorigin="anonymous"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js" crossorigin="anonymous"></script>
  <script src="/js/chessgame.js"></script>
</body>
